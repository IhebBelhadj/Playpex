# Copy to .env and fill in. Real environment variables take precedence.

# TMDB API key (https://www.themoviedb.org/settings/api) - used by the server for recommendations
# and as the default metadata provider of the 18+ section
TMDB_API_KEY=

# Credentials the server provides to a plugin by default (the admin's own, entered on the dashboard,
# win): PLAYPEX_PLUGIN_<PLUGIN ID>_<SECRET NAME> (apps/server/lib/plugins/envSecrets.js). The YouTube
# plugin: a YouTube Data API v3 key, and a Google OAuth client of type "TVs and Limited Input devices"
# (its consent screen published "In production") so people link their Google account with a code only
# PLAYPEX_PLUGIN_YOUTUBE_API_KEY=
# PLAYPEX_PLUGIN_YOUTUBE_CLIENT_ID=
# PLAYPEX_PLUGIN_YOUTUBE_CLIENT_SECRET=

# Optional subtitle providers
# OPENSUBTITLES_API_KEY=
# WYZIE_API_KEY=

# Optional server settings. Each one overrides the same setting in <config dir>/settings.json
# (apps/server/lib/settings.js); installs have no .env and use settings.json.
# PLAYPEX_PORT=28470            # HTTP port (STREAMER_PORT still works)
# PLAYPEX_LAN_SHARING=0         # 1 = listen on all interfaces (no auth yet!), 0 = loopback only
# PLAYPEX_LOG_LEVEL=info        # debug | info | warn | error
# PLAYPEX_DOWNLOAD_DIR=
# FFMPEG_PATH= / FFPROBE_PATH=  # else the bundled copy, else the PATH

# Optional data locations
# PLAYPEX_CONFIG_DIR=
# PLAYPEX_CACHE_DIR=
# PLAYPEX_LOG_DIR=
