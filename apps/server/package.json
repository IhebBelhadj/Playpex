    "axios": "^0.27.2",
    "better-auth": "^1.7.10",
    "bonjour-service": "^1.4.4",
    "connect-multiparty": "^2.0.0",
    "dotenv": "^16.0.3",
    "drizzle-orm": "^0.45.4",
    "express": "^4.17.1",
    "lodash": "^4",
    "mkdirp": "^0.5.5",
    "pump": "^3.0.0",
    "quickjs-emscripten-core": "^0.32.0",
    "range-parser": "^1.2.0",
    "read-torrent": "^1.3.1",
    "torrent-stream": "^1.2.1",
