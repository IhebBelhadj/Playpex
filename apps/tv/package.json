{
  "name": "@playpex/tv",
  "productName": "Playpex TV",
  "version": "0.9.0",
  "private": true,
  "description": "Playpex TV: a 10-foot client of Playpex Media Server",
  "author": "Iheb Belhaj",
  "homepage": "https://github.com/IhebBelhadj/Playpex",
  "license": "SEE LICENSE IN licence.md",
  "keywords": [
    "Playpex",
    "Streamer",
    "media",
    "tv",
    "movies",
    "Media Player"
  ],
  "main": "electron/main.js",
  "desktopName": "playpex-tv.desktop",
  "scripts": {
    "ng": "ng",
    "start": "ng serve -o",
    "build": "ng build --base-href ./",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "check:ui": "node scripts/check-ui.js",
    "check:contrast": "node scripts/check-contrast.js",
    "check:plugins": "node scripts/check-plugins.js",
    "electron": "ng build --base-href ./ && electron .",
    "electron:last": "node -e \"require('fs').existsSync('dist/playpex/index.html') || (console.error('No build in apps/tv/dist/playpex: run npm run build (or npm run electron) first'), process.exit(1))\" && electron .",
    "pack": "ng build --base-href ./ && electron-builder --dir",
    "dist": "ng build --base-href ./ && electron-builder",
    "dist:linux": "ng build --base-href ./ && electron-builder --linux",
    "dist:win": "ng build --base-href ./ && electron-builder --win",
    "dist:mac": "ng build --base-href ./ && electron-builder --mac",
    "screens": "ng build --configuration development --base-href ./ --output-path dist/screens && electron scripts/screens.js",
    "scenario": "ng build --configuration development --base-href ./ --output-path dist/screens && electron scripts/scenario.js",
    "perf": "ng build --configuration development --base-href ./ --output-path dist/screens && electron scripts/scenario.js perf"
  },
  "dependencies": {
    "@playpex/protocol": "*",
    "bonjour-service": "^1.4.4",
    "electron-shutdown-command": "^2.0.1",
    "electron-updater": "^6.8.9",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^14.0.2",
    "@angular/animations": "^14.0.0",
    "@angular/cli": "~14.0.2",
    "@angular/common": "^14.0.0",
    "@angular/compiler": "^14.0.0",
    "@angular/compiler-cli": "^14.0.0",
    "@angular/core": "^14.0.0",
    "@angular/forms": "^14.0.0",
    "@angular/platform-browser": "^14.0.0",
    "@angular/platform-browser-dynamic": "^14.0.0",
    "@angular/router": "^14.0.0",
    "@types/gsap": "^3.0.0",
    "@types/jasmine": "~4.0.0",
    "@types/youtube": "^0.0.47",
    "electron": "44.7.0",
    "electron-builder": "^26.15.3",
    "gsap": "^3.10.4",
    "jasmine-core": "~4.1.0",
    "karma": "~6.3.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.0.0",
    "karma-jasmine-html-reporter": "~1.7.0",
    "rxjs": "~7.5.0",
    "tslib": "^2.3.0",
    "typescript": "~4.7.2",
    "zone.js": "~0.11.4"
  },
  "build": {
    "appId": "app.playpex.tv",
    "productName": "Playpex TV",
    "executableName": "playpex-tv",
    "copyright": "Iheb Belhaj",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/playpex/**/*",
      "electron/**/*",
      "!electron/remoteWs.js",
      "package.json",
      "!node_modules/@playpex/protocol/{README.md,openapi.yaml,types}{,/**}"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "../../licence.md",
        "to": "licence.md"
      }
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/IhebBelhadj/Playpex/releases/download/tv-channel"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Playpex TV",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "license": "../../licence.md",
      "artifactName": "Playpex-TV-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.entertainment",
      "icon": "build/icon.png",
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "Playpex TV looks for Playpex Media Server on your local network.",
        "NSBonjourServices": [
          "_playpex._tcp"
        ]
      }
    },
    "dmg": {
      "artifactName": "Playpex-TV-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "icon": "build/icon.png",
      "synopsis": "Playpex TV, a client of Playpex Media Server",
      "maintainer": "Iheb Belhaj <noreply@playpex.app>",
      "artifactName": "Playpex-TV-${version}-${arch}.${ext}",
      "desktop": {
        "entry": {
          "Name": "Playpex TV",
          "Comment": "Watch movies and series from your Playpex Media Server"
        }
      }
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ]
    }
  }
}
