---
// The remote: a row of Playpex TV (the films on the demo server, dithered posters that light up when focused) and a
// pad; scripts/home/remote.js drives it. Used by the home page and the Playpex TV page.
import { Image } from 'astro:assets';
import { IMG } from '../lib/images';
import { FILMS } from '../data/site';

interface Props { title: string; text: string }
const { title, text } = Astro.props;
const ARROW = { up: 'm6 15 6-6 6 6', left: 'm15 6-6 6 6 6', right: 'm9 6 6 6-6 6', down: 'm6 9 6 6 6-6' };
const arrow = (d: string) => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="${d}"/></svg>`;
---
<section class="remote" id="remote" aria-labelledby="remote-title">
    <div class="wrap">
      <div class="remote-head rv">
        <h2 id="remote-title">{title}</h2>
        <p>{text}</p>
      </div>
      <div class="tvrow rv" style="--d:1" id="tvrow" tabindex="0" role="listbox" aria-label="Films on this server, in Playpex TV" data-ui>
        <div class="meta"><b id="tv-title">{FILMS[0][0]}</b><span id="tv-sub">{FILMS[0][1]}</span></div>
        <div class="track" id="track">
          {FILMS.map(([title, sub], i) => (
            <div class="poster" role="option" id={`pf${i}`} aria-label={title} aria-selected={i === 0 ? 'true' : 'false'} data-title={title} data-sub={sub}>
              <canvas></canvas><Image class="col" src={IMG[`p${i}`]} alt="" widths={[240, 400]} sizes="185px" loading="lazy" />
            </div>
          ))}
        </div>
        <div class="chooser" id="chooser" hidden><Image src={IMG.s_resume} alt="Playpex TV asking whether to resume Sintel at 5:18 or play it from the beginning" widths={[640, 1200]} sizes="(min-width: 900px) 60vw, 100vw" loading="lazy" /></div>
      </div>
      <div class="pad-wrap rv" style="--d:2">
        <div class="pad" id="pad">
          {(['up', 'left'] as const).map((k) => <button class={`ar ${k}`} type="button" data-k={k} aria-label={k[0].toUpperCase() + k.slice(1)}><Fragment set:html={arrow(ARROW[k])} /></button>)}
          <button class="ok" type="button" data-k="ok">OK</button>
          {(['right', 'down'] as const).map((k) => <button class={`ar ${k}`} type="button" data-k={k} aria-label={k[0].toUpperCase() + k.slice(1)}><Fragment set:html={arrow(ARROW[k])} /></button>)}
        </div>
        <button class="back" type="button" data-k="back"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 14 4 9l5-5"/><path d="M4 9h10.5a5.5 5.5 0 0 1 0 11H11"/></svg>Back</button>
        <p id="pad-hint" aria-live="polite">OK on Sintel opens it, Back closes it.</p>
      </div>
    </div>
  </section>
