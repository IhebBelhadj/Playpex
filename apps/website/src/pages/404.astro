---
// 404: the address leads nowhere. "404" in the footer's dot-matrix digits, then the ways back. Cloudflare Pages serves
// this file for unknown addresses (without it, it would answer them with the home page).
import Base from '../layouts/Base.astro';
import { led } from '../lib/led';
const home = import.meta.env.BASE_URL;
---
<Base title="Page not found · Playpex" description="This address leads to no page of the Playpex site.">
<main class="nf">
  <span class="mx" role="img" aria-label="404"><Fragment set:html={led('404', 'n')} /></span>
  <h1>This page isn’t here.</h1>
  <p>The address may be mistyped, or the page has moved. Start again from the home page, or look in the docs.</p>
  <div class="go"><a class="btn" href={home}>Go to the home page</a><a class="alt" href={home + 'docs/'}>Open the docs</a></div>
</main>
</Base>
<style>
  .nf { max-width: 1440px; margin: 0 auto; padding: 96px var(--m) 120px; min-height: calc(100svh - var(--bar-h)); display: grid; align-content: center; justify-items: start; gap: 20px; }
  .mx :global(svg) { width: min(100%, 360px); height: auto; display: block; margin-bottom: 20px; }
  .mx :global(.l) { fill: var(--dot); } .mx :global(.u) { fill: var(--led-off); }
  h1 { font-size: clamp(36px, 4.4vw, 60px); font-weight: 800; letter-spacing: -.03em; line-height: 1.05; }
  p { font-size: 19px; color: var(--text-2); max-width: 34em; }
  .go { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 12px; }
  .alt { display: inline-flex; align-items: center; height: 54px; padding: 0 24px; border-radius: 999px; box-shadow: inset 0 0 0 1.5px var(--line); font-weight: 600; }
  .alt:hover { background: var(--hover); }
</style>
