---
// The home page. Everything a visitor reads is in the HTML; scripts/home.js adds the motion (the held intro, the
// scenes), the remote, the switches and the download choice.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Remote from '../components/Remote.astro';
import Rooms from '../components/Rooms.astro';
import DownloadField from '../components/DownloadField.astro';
import { IMG, LOOP_VIDEO, imageMap } from '../lib/images';
import { ICON } from '../lib/icons';
import { SITE, RELEASE, PRODUCTS, PEOPLE, DOWNLOADS } from '../data/site';
import '../styles/desktop.css';
import '../styles/phone.css';

const scriptImages = JSON.stringify({ images: await imageMap(), loop: LOOP_VIDEO });
const SHELF = ['a-srv', 'a-tv', 'a-and', 'a-man'];
const BEATS = [
  ['It starts on the server.', 'The dashboard of the computer that keeps your films, in any browser.'],
  ['Then it’s on the TV.', 'Playpex TV shows what’s on the server, made for a remote and a sofa.'],
  ['Every title has its page.', 'Sintel, on this server: its story, its cast, its ratings and a Play button.'],
  ['It knows where you stopped.', 'Resume at the same minute on any screen, or start again.'],
  ['And it plays.', 'Every audio track and subtitle in the file, on the biggest screen in the house.'],
];
const ROOMS = [
  { shot: 's_downloads', alt: 'The dashboard’s Downloads: Sintel downloaded and seeding, with its details', title: 'A torrent client that keeps what you get', text: 'Queue, pause, seed and set limits. Leaving the player pauses a download; nothing is deleted unless you remove it.' },
  { shot: 's_watch', alt: 'Sintel playing in the dashboard’s player in a browser', title: 'A player in your browser', text: 'Watch anything on the server from the dashboard, even while it’s still downloading.' },
  { shot: 's_subs', alt: 'Playpex TV’s subtitle settings listing Sintel’s subtitles from online providers', title: 'Subtitles, found for you', text: 'The tracks in the file, plus OpenSubtitles and YIFY, with size and timing in the player.' },
  { shot: 's_profiles', alt: 'Playpex TV’s Who’s watching screen with four profiles, one for kids', title: 'A profile for everyone', text: 'Watch lists and resume points per person. Kids’ profiles only see what’s for them.' },
];
const face = (fill: string) => `<svg viewBox="0 0 100 100" aria-hidden="true"><circle cx="50" cy="50" r="50" style="fill:${fill}"/><circle cx="35" cy="40" r="6" class="ink"/><circle cx="65" cy="40" r="6" class="ink"/><path d="M30 60 Q50 78 70 60" class="smile"/></svg>`;
const SCREEN_SIZES = '(min-width: 900px) 60vw, 100vw';
---
<Base>
<!-- the loading screen (home/preload.js): the Playpex mark lights dot by dot as the page's parts arrive, then the
     gold dots uncover the page. Only with script, never when arriving from the other site (already covered) -->
<script is:inline>(function (d) { if (d.classList.contains('switching')) return; d.classList.add('preloading'); setTimeout(function () { d.classList.remove('preloading'); }, 9000); })(document.documentElement);</script>
<div class="preload" id="preload" aria-hidden="true">
  <div class="preload-mark">
    <svg viewBox="6.5 6.7 20.8 18.6"><defs><pattern id="pl-dots" x="6.5" y="6.7" width=".547" height=".547" patternUnits="userSpaceOnUse"><circle cx=".2735" cy=".2735" r=".197" style="fill:var(--unlit)"/></pattern><clipPath id="pl-clip"><polygon points="9.24,11.1 21.58,17.23 14.34,24.17 26.79,16.99 7,7.21 7,11.5 7,24.79"/></clipPath></defs><rect x="6.5" y="6.7" width="20.8" height="18.6" fill="url(#pl-dots)" clip-path="url(#pl-clip)"/></svg>
    <canvas></canvas>
  </div>
  <span class="preload-n" id="preload-n">0</span>
</div>
<main id="main">
  <section class="intro" id="intro" aria-labelledby="hero-title">
    <!-- the held layout is chosen before the first paint (no shift when the script starts); home/intro.js takes it
         back where it can't run (no WebGL) -->
    <script is:inline>if (!matchMedia('(prefers-reduced-motion: reduce)').matches) { document.currentScript.parentNode.classList.add('is-held'); document.documentElement.classList.add('held'); }</script>
    <div class="istage">
      <canvas id="gl" aria-hidden="true"></canvas>
      <div class="iscrim" id="iscrim" aria-hidden="true"></div>
      <div class="iwrap" id="iwrap">
        <div class="words">
          <div class="heroblock" id="heroblock">
            <h1 class="big" id="hero-title">Your library.<span>Every screen.</span></h1>
            <p class="lede">{SITE.description}</p>
            <div class="ctas"><a class="btn" href="#download" data-dl><Fragment set:html={ICON.download} />Download Playpex</a><a class="ghostbtn" href="#products" id="how-link">See how it works</a></div>
            <p class="note">Free. Version {RELEASE.version} for Windows, macOS, Linux and phones</p>
          </div>
          <div class="beat b1" id="b1"><h2>Your films sit in folders.</h2><p>On the computer that keeps them, or on a network share. Point Playpex at them once.</p></div>
          <div class="beat b2" id="b2"><h2>Now they’re a library.</h2><p>Every file is matched to its title, with the poster, the cast and the ratings.</p></div>
          <div class="beat b3" id="b3"><h2 class="b3-h">Four apps, one library</h2><ul class="b3-list" id="b3-list"></ul><div class="b3-fact" id="b3-fact"></div></div>
        </div>
        <div class="slot" id="slot"><Image class="slot-still" src={IMG.s_dashlib} alt="The Playpex dashboard’s Library: posters of the films on the server, A to Z" widths={[640, 960, 1280, 1600]} sizes={SCREEN_SIZES} loading="eager" /></div>
      </div>
    </div>
  </section>

  <section class="apps2" id="products" aria-labelledby="apps-title">
    <div class="wrap">
      <div class="apps2-head">
        <h2 id="apps-title">Four apps, one library</h2>
        <p>Install the server once. Every screen in the house then shows the same films, the same watch list and the minute you stopped at.</p>
      </div>
      <ul class="shelf">
        {PRODUCTS.map((p, i) => (
          <li class={`app ${SHELF[i]}`}>
            <figure class="scr"><Image src={IMG[p.shot]} alt={p.shotAlt} widths={p.device === 'phone' ? [270, 540] : [480, 800, 1200]} sizes={p.device === 'phone' ? '270px' : '(min-width: 900px) 40vw, 100vw'} /></figure>
            <div class="txt"><h3>{p.name}</h3><p>{p.blurb}</p><span>{p.systems}</span></div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="scene sc-screens" id="screens" data-scene="screens" aria-labelledby="screens-title">
    <div class="scene-stage">
      <div class="sc-wrap">
        <div class="sc-words beats">
          {BEATS.map(([h, t], i) => <div class:list={['beat', { last: i === BEATS.length - 1 }]}><h2 id={i === 0 ? 'screens-title' : undefined}>{h}</h2><p>{t}</p></div>)}
        </div>
        <div class="sc-screen" id="screens-screen">
          <Image class="still" src={IMG.s_player} alt="Playpex TV playing Sintel at 5:18, with the player’s controls" widths={[640, 960, 1280, 1600]} sizes={SCREEN_SIZES} />
          <canvas class="gl" aria-hidden="true"></canvas>
          <video muted loop playsinline preload="none" aria-hidden="true"></video>
          <div class="scrim" aria-hidden="true"></div>
        </div>
      </div>
    </div>
  </section>

  <Remote title="Made for the remote on your couch" text="Playpex TV moves with arrows, OK and Back, and whatever you point at comes forward. Try it here with the pad or your arrow keys." />

  <Rooms id="server" title="The server does the rest" rooms={ROOMS} />

  <section class="feats" id="features" aria-labelledby="feat-title">
    <div class="wrap who-head"><h2 id="feat-title">Four people, one house</h2><p>Profiles keep each person’s list, place and settings. Switch on what each of them needs.</p></div>
    <ul class="who">
      {PEOPLE.map((p, i) => (
        <li class:list={['person', { dark: p.dark }]} style={`--fill:${p.fill}`}>
          <div class="wrap">
            <div class="pwords">
              <div class="face">{p.face ? <Fragment set:html={face(p.face)} /> : <span class="all"><Fragment set:html={PEOPLE.slice(0, 4).map((q) => face(q.face)).join('')} /></span>}</div>
              <h3>{p.line}</h3>
              <button type="button" class="sw2" role="switch" aria-checked="false" id={`pp${i}`}><i aria-hidden="true"></i><span>{p.toggle}</span></button>
              <p>{p.note}</p>
            </div>
            <figure class:list={['pic', { tall: p.tall }]} data-shot={p.shot}><Image src={IMG[p.shot]} alt={p.alt} widths={p.tall ? [320, 640] : [640, 1200]} sizes={p.tall ? '330px' : '(min-width: 900px) 56vw, 100vw'} loading="lazy" /></figure>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <DownloadField
    title="Start with the server."
    text="It’s free. Install it on the computer that keeps your films; Playpex TV and Playpex Mobile find it on your Wi-Fi after that."
    links={[{ href: `${import.meta.env.BASE_URL}tv`, label: 'Playpex TV' }, { href: `${import.meta.env.BASE_URL}mobile`, label: 'Playpex Mobile' }, { href: `${import.meta.env.BASE_URL}releases`, label: 'All releases' }]}
    dialog="Download Playpex Media Server" files={DOWNLOADS} />
</main>
<script type="application/json" id="img-map" set:html={scriptImages} />
</Base>

<script>
  import '../scripts/home.js';
</script>
