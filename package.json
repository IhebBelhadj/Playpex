{
  "name": "playpex",
  "version": "0.9.0",
  "private": true,
  "author": "Iheb Belhaj",
  "description": "Playpex: a media server and its TV client (npm workspaces, see docs/server-separation-plan.md)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm start -w apps/tv",
    "build": "npm run build -w apps/tv",
    "test": "npm test -w apps/tv",
    "check:ui": "npm run check:ui -w apps/tv",
    "check:contrast": "npm run check:contrast -w apps/tv",
    "check:plugins": "npm run check:plugins -w apps/tv",
    "electron": "npm run electron -w apps/tv",
    "electron:last": "npm run electron:last -w apps/tv",
    "server": "npm start -w apps/server",
    "install:engine": "npm run install:engine -w apps/server --",
    "pack:plugin": "npm run pack:plugin -w apps/server --",
    "build:torrentd": "node engines/torrentd/build.js",
    "test:server": "npm test -w apps/server",
    "db:generate": "npm run db:generate -w apps/server",
    "dist:tv": "npm run dist -w apps/tv",
    "dashboard": "npm run dev -w apps/dashboard",
    "build:dashboard": "npm run build -w apps/dashboard",
    "server:desktop": "npm start -w apps/server-desktop",
    "dist:server-desktop": "npm run dist -w apps/server-desktop"
  }
}
