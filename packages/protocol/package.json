{
  "name": "@playpex/protocol",
  "version": "1.0.0",
  "private": true,
  "description": "The Playpex client/server protocol: OpenAPI spec, TypeScript types generated from it, shared constants",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "settings.js",
    "settings.d.ts",
    "plugins.js",
    "plugins.d.ts",
    "plugin.schema.json",
    "plugin-api.schema.json",
    "repository.schema.json",
    "signing.js",
    "signing.d.ts",
    "mdns.js",
    "local.js",
    "openapi.yaml",
    "types/"
  ],
  "scripts": {
    "generate": "openapi-typescript openapi.yaml -o types/api.d.ts"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3"
  }
}
