{
  "$schema": "../../packages/protocol/plugin.schema.json",
  "id": "adult",
  "name": "18+",
  "description": "Adult films: a catalog from TMDB studios or ThePornDB, and torrent releases ranked by seeders. Never in the official repository.",
  "version": "1.0.0",
  "publisher": {
    "name": "Playpex"
  },
  "api": {
    "server": "^1",
    "nav": "^1",
    "ui": "^1"
  },
  "audience": "adults",
  "icon": "assets/seal.svg",
  "listing": {
    "summary": "Adult films: a catalog from TMDB studios or ThePornDB, and torrent releases ranked by seeders.",
    "disclaimer": "Adult content. Hidden from kids profiles and never shared over DLNA. Streaming copyrighted content via torrents may be illegal where you live.",
    "license": "See licence.md",
    "categories": [
      "catalog",
      "sources"
    ]
  },
  "permissions": {
    "network": [
      "apibay.org",
      "therarbg.to",
      "therarbg.com",
      "api.theporndb.net",
      "api.themoviedb.org"
    ],
    "storage": "1MB",
    "secrets": [
      "tmdbApiKey",
      "theporndbApiKey"
    ],
    "play": true,
    "sources": [
      "magnet"
    ]
  },
  "contributes": {
    "sections": [
      {
        "screen": "browse",
        "menu": {
          "label": "18+",
          "icon": "assets/seal.svg",
          "order": 50
        }
      }
    ],
    "screens": [
      {
        "name": "browse",
        "template": "catalog",
        "data": "browse",
        "title": "18+"
      },
      {
        "name": "title",
        "template": "title",
        "data": "title",
        "params": [
          "provider",
          "id"
        ]
      },
      {
        "name": "releases",
        "template": "releases",
        "data": "releases",
        "title": "18+"
      },
      {
        "name": "find",
        "template": "releases",
        "data": "releases",
        "params": [
          "q"
        ]
      }
    ],
    "slots": [
      {
        "slot": "core.search.filters",
        "data": "searchFilter"
      }
    ],
    "settings": [
      {
        "key": "metadataProvider",
        "scope": "profile",
        "type": "choice",
        "label": "Catalog from",
        "group": "Catalog",
        "description": "Where the posters, studios and performers come from (the other one is used when this one has no key).",
        "options": [
          [
            "tmdb",
            "TMDB"
          ],
          [
            "theporndb",
            "ThePornDB"
          ]
        ],
        "default": "tmdb"
      },
      {
        "key": "tmdbApiKey",
        "scope": "server",
        "type": "secret",
        "label": "TMDB API key",
        "group": "Catalog",
        "description": "For the TMDB catalog (adult films through their studios): a free key from themoviedb.org."
      },
      {
        "key": "theporndbApiKey",
        "scope": "server",
        "type": "secret",
        "label": "ThePornDB API key",
        "group": "Catalog",
        "description": "For the ThePornDB catalog (theporndb.net, free account)."
      }
    ],
    "chrome": {
      "accent": "adult"
    }
  }
}
